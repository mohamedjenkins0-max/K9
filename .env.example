# GEMINI_API_KEY: Optional runtime AI features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE CONFIGURATION (PostgreSQL, Auth & Storage)
# ==============================================================================
# Public project URL from Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Public anon/public key safe for client-side queries (RLS enforced)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Secret Service Role Key - NEVER expose to frontend. Used strictly in server backend / Edge Functions:
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Institutional Defaults:
VITE_DEFAULT_CURRENCY="SLE"
VITE_TIMEZONE="Africa/Freetown"
